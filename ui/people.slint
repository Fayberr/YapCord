import { ClientStyle } from "yapfast/style.slint";
import { ScrollView, ListView } from "scrollview.slint";
import { Theme, Middle, Label, Tip, BadgeTip } from "theme.slint";
import { ActionButton, IconButton, Avatar, Nameplate, StatusText, StyledName, NameStyleRow, EffectLayer, ProfileEffect, PictureStore, TextField, ServerTagChip } from "controls.slint";
import { StatusDot } from "rail.slint";

/// A member of the open room. A heading starts each role's group.
export struct MemberRow {
    id: string, name: string, initial: string, tint: color, picture: image, heading: string,
    /// Discord's presence: "online", "mobile" (online only on a phone), "idle",
    /// "dnd" or "offline"; empty for Matrix.
    presence: string,
    /// The name's colour, from a coloured Discord role.
    color: color, has-color: bool,
    /// A custom status or what they're doing, under the name, and the
    /// address of its custom emoji's picture.
    activity: string, activity-emoji: string,
    picture-url: string,
    /// The address of the decoration around their avatar, and of their
    /// nameplate's picture with its palette's colour; empty for none.
    decoration-url: string, nameplate-url: string, nameplate-color: color,
    /// How their name is drawn.
    name-style: NameStyleRow,
    /// Timed out in their Discord server, marked with a clock by the name.
    timed-out: bool,
    /// The server tag they wear by their name, and its badge's address.
    tag: string, tag-badge: string,
}

// The open room's members, grouped by role under the conversation header.
export component MemberPanel inherits Rectangle {
    in property <[MemberRow]> rows;
    /// Shown instead of the list while it loads or when it can't.
    in property <string> note;
    /// The member whose profile card is open.
    in property <string> selected;
    /// A member was clicked: their id, and where their row is in the window.
    callback open-profile(string, length);
    /// A member was right-clicked: their id, and where in the window.
    callback open-member-menu(string, length, length);
    background: Theme.sidebar;
    accessible-role: list;
    accessible-label: "Members";
    VerticalLayout {
        if root.note != "": HorizontalLayout { padding: 16px; Label { text: root.note; } }
        // A list view makes only the rows in sight, which matters in large servers.
        ListView {
            vertical-stretch: 1;
            for member[index] in root.rows: VerticalLayout {
                padding-left: 8px; padding-right: 8px;
                padding-top: index == 0 ? 8px : 0px;
                padding-bottom: index == root.rows.length - 1 ? 12px : 2px;
                spacing: 2px;
                // Discord's group heading: 14px medium in the channel grey, 20px above and 4px below.
                if member.heading != "": HorizontalLayout {
                    padding-left: 8px; padding-top: 20px; padding-bottom: 4px; height: 42px;
                    Text { text: member.heading; color: #81828a; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                }
                Rectangle {
                  height: 42px; border-radius: 8px;
                  background: member.id == root.selected ? #97979f33 : member-pointer.has-hover ? #97979f1f : transparent;
                  if member.nameplate-url != "": Nameplate {
                      radius: 8px; picture-url: member.nameplate-url; palette: member.nameplate-color;
                      hovered: member-pointer.has-hover; selected: member.id == root.selected;
                      animate: member-pointer.has-hover || member.id == root.selected;
                      ground: member.id == root.selected ? Theme.active : member-pointer.has-hover ? Theme.hover : Theme.sidebar;
                      content-width: min(text-column.preferred-width, text-column.width);
                      opacity: member.presence == "offline" ? 0.5 : 1;
                  }
                  accessible-role: button;
                  accessible-label: member.name + ", " + member.id + ", show profile";
                  accessible-action-default => { root.open-profile(member.id, self.absolute-position.y); }
                  member-pointer := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-profile(member.id, self.absolute-position.y); }
                    pointer-event(event) => {
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            root.open-member-menu(member.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                  }
                  HorizontalLayout {
                    padding-left: 8px; padding-right: member.nameplate-url != "" ? 12px : 8px; spacing: 12px;
                    // Offline Discord members are faded, as in Discord.
                    Middle {
                        Rectangle {
                            width: 32px; height: 32px;
                            Avatar { size: 32px; initial: member.initial; tint: member.tint; picture: member.picture; picture-url: member.picture-url; decoration-url: member.decoration-url; animate: member-pointer.has-hover; prefetch: true; opacity: member.presence == "offline" ? 0.4 : 1; }
                            if member.presence != "" && member.presence != "offline": StatusDot { x: 20px; y: 20px; presence: member.presence; ring: Theme.sidebar; }
                        }
                    }
                    text-column := VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: start; spacing: 4px;
                            if member.name-style.effect == 0: Text {
                                text: member.name; color: member.has-color ? member.color : Theme.secondary; font-size: 16px; font-weight: 500; overflow: elide;
                                opacity: member.presence == "offline" ? 0.5 : 1;
                            }
                            if member.name-style.effect > 0: StyledName {
                                text: member.name; style: member.name-style; ink: member.has-color ? member.color : Theme.secondary; font-size: 16px; font-weight: 500;
                                opacity: member.presence == "offline" ? 0.5 : 1;
                            }
                            if member.tag != "": Middle {
                                ServerTagChip { text: member.tag; badge: member.tag-badge; opacity: member.presence == "offline" ? 0.5 : 1; }
                            }
                            if member.timed-out: Image {
                                source: @image-url("icons/clock.svg"); width: 14px; image-fit: contain;
                                colorize: Theme.danger;
                                accessible-role: image; accessible-label: "Timed out";
                            }
                        }
                        if member.activity != "" || member.activity-emoji != "": StatusText {
                            text: member.activity; emoji-url: member.activity-emoji; font-size: 12px;
                            opacity: member.presence == "offline" ? 0.5 : 1;
                        }
                    }
                  }
                }
            }
        }
    }
}

export struct ProfileRole { name: string, color: color, has-color: bool }
/// A profile card's roles a row at a time, laid out to fit the card.
export struct ProfileRoleRow { roles: [ProfileRole] }
/// A server a profile's person shares with this account, and their nickname there.
export struct ProfileServerRow {
    id: string, name: string, initial: string, picture: image, banner: image,
    /// "12 members", when known, and "4 channels".
    members: string, channels: string,
    nick: string,
}
/// A friend a profile's person shares with this account; presence as in MemberRow.
export struct ProfileFriendRow { id: string, name: string, initial: string, tint: color, picture: image, presence: string }
/// One of someone's activities, as their profile's card shows it.
export struct ActivityRow {
    /// "PLAYING", "LISTENING TO SPOTIFY" and the like.
    heading: string,
    /// The game or app, or a Hang status's words, after its emoji's picture.
    name: string, name-emoji: string,
    details: string, state: string,
    /// The addresses of its large and small pictures, and what they name.
    large-url: string, large-text: string, small-url: string, small-text: string,
    /// When it started and when it ends, in ActivityClock's seconds; 0 when
    /// Discord didn't say.
    start: int, end: int,
    /// A stream's address, and what the title opens, such as a Spotify
    /// song's page.
    url: string, link: string,
}

/// Now, for activities' timers: seconds since 2020 began, kept current
/// once a second while a profile with a timed activity shows.
export global ActivityClock {
    in property <int> now;
}

/// One of someone's badges: the address of its picture, what it says on
/// hover, and where a click goes, empty when nowhere. A badge that levels up
/// has a `title` too: its tooltip shows `kind` above it, `progress` below it
/// and the large `picture` of the level above them.
export struct ProfileBadgeRow { icon: string, description: string, link: string, kind: string, title: string, progress: string, picture: string }

export struct ProfileData {
    id: string, name: string, initial: string, tint: color, picture: image,
    /// The address of the decoration around their avatar, and how their name
    /// is drawn.
    decoration-url: string, name-style: NameStyleRow,
    /// The profile effect over the card: its layers, the picture a persistent
    /// one holds, when its last layer that doesn't loop ends in milliseconds,
    /// and whether one loops.
    effect-layers: [EffectLayer], effect-still: string, effect-persistent: bool, effect-end: int, effect-loops: bool,
    /// The colours of the profile's theme, a Nitro setting, which tint the
    /// card's gradient and border; the card is plain without them.
    theme-primary: color, theme-secondary: color, has-theme: bool,
    /// A Discord username or Matrix ID, then pronouns when they give them.
    handle: string,
    /// The server tag they wear by their name, and its badge's address.
    tag: string, tag-badge: string,
    /// The banner picture, else its colour.
    banner: image, accent: color, has-accent: bool,
    /// As in MemberRow.
    presence: string, activity: string, activity-emoji: string,
    /// What they're doing, in full: games, music, streams.
    activities: [ActivityRow],
    /// The badges Discord shows beside the handle, in its order.
    badges: [ProfileBadgeRow],
    bio: styled-text, has-bio: bool,
    role-rows: [ProfileRoleRow], role-rows-large: [ProfileRoleRow],
    /// Dates: on Discord since, and in this server since.
    created: string, joined: string,
    servers: [ProfileServerRow], friends: [ProfileFriendRow],
    /// Loading, or why there's no more.
    note: string,
    /// Friendship on Discord: 0 nothing to offer, 1 send a friend request,
    /// 2 one was sent, 3 accept theirs.
    friend: int,
    /// The card's box that messages them in their DM, as "Message @name";
    /// empty when there's none.
    message-hint: string,
}

export component ProfileHeading inherits Text {
    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
}

// An activity's picture: square with rounded corners, asked for as it shows.
component ActivityPicture inherits Rectangle {
    in property <string> url;
    in property <string> label;
    in property <length> size;
    property <image> picture: root.url != "" ? PictureStore.picture(root.url, PictureStore.revision) : @image-url("");
    function request() {
        if root.url != "" && root.picture.width == 0 {
            PictureStore.request(root.url);
        }
    }
    init => { root.request(); }
    changed url => { root.request(); }
    changed picture => { root.request(); }
    width: root.size; height: root.size;
    border-radius: root.size / 6; clip: true;
    background: Theme.raised;
    accessible-role: image;
    accessible-label: root.label;
    Image { source: root.picture; width: root.size; height: root.size; image-fit: cover; }
}

// A badge on a profile: its picture, with its name on hover, opening its
// page when Discord gives it one.
component ProfileBadge inherits Rectangle {
    in property <ProfileBadgeRow> badge;
    callback open-link(string);
    property <image> picture: root.badge.icon != "" ? PictureStore.picture(root.badge.icon, PictureStore.revision) : @image-url("");
    property <image> level-picture: root.badge.picture != "" ? PictureStore.picture(root.badge.picture, PictureStore.revision) : @image-url("");
    function request() {
        if root.badge.icon != "" && root.picture.width == 0 {
            PictureStore.request(root.badge.icon);
        }
        if root.badge.picture != "" && root.level-picture.width == 0 {
            PictureStore.request(root.badge.picture);
        }
    }
    init => { root.request(); }
    changed badge => { root.request(); }
    changed picture => { root.request(); }
    changed level-picture => { root.request(); }
    width: 20px; height: 20px;
    accessible-role: image;
    accessible-label: root.badge.description;
    Image { source: root.picture; width: parent.width; height: parent.height; image-fit: contain; }
    badge-pointer := TouchArea {
        mouse-cursor: root.badge.link != "" ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if root.badge.link != "" { root.open-link(root.badge.link); } }
        changed has-hover => {
            if self.has-hover {
                tip-delay.running = true;
            } else {
                tip-delay.running = false;
                if BadgeTip.title == root.badge.title && root.badge.title != "" {
                    BadgeTip.title = "";
                } else if Tip.text == root.badge.description {
                    Tip.text = "";
                    Tip.pop = false;
                }
            }
        }
    }
    // Discord's tooltips wait for the pointer to rest on a badge for about
    // half a second before they pop up.
    tip-delay := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if root.badge.title != "" {
                BadgeTip.kind = root.badge.kind;
                BadgeTip.title = root.badge.title;
                BadgeTip.progress = root.badge.progress;
                BadgeTip.picture-url = root.badge.picture;
                BadgeTip.x = badge-pointer.absolute-position.x + badge-pointer.width / 2;
                BadgeTip.y = badge-pointer.absolute-position.y;
            } else {
                Tip.pop = true;
                Tip.text = root.badge.description;
                Tip.side = 0;
                Tip.x = badge-pointer.absolute-position.x + badge-pointer.width / 2;
                Tip.y = badge-pointer.absolute-position.y;
            }
        }
    }
}

// The tooltip of a badge that levels up, set by Discord's own values: 200px
// wide on the surface-high grey, 8px corners and a 1px edge, 12px inside at
// the sides and 16px above and below, the level's picture 64px high, then
// the kind, the level in capitals and the progress 4px apart.
export component BadgeTipCard inherits Rectangle {
    property <image> level-picture: BadgeTip.picture-url != "" ? PictureStore.picture(BadgeTip.picture-url, PictureStore.revision) : @image-url("");
    // It pops up: fades in and grows from the caret, as Discord's does.
    property <bool> shown: false;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 120ms; easing: ease-out; }
    transform-scale: root.shown ? 1 : 0.95;
    transform-origin: { x: self.width / 2, y: self.height };
    animate transform-scale { duration: 120ms; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: true;
        triggered => { self.running = false; root.shown = true; }
    }
    width: 200px;
    height: card.preferred-height;
    background: #242429;
    border-radius: 8px;
    border-width: 1px;
    border-color: #97979f1f;
    drop-shadow-blur: 24px; drop-shadow-color: #0000003d; drop-shadow-offset-y: 12px;
    // The caret under it, pointing at the badge.
    Path {
        x: parent.width / 2 - 8px; y: parent.height - 1px; width: 16px; height: 9px;
        commands: "M 0 0 L 16 0 L 8 9 Z";
        fill: #242429;
    }
    card := VerticalLayout {
        padding-left: 12px; padding-right: 12px; padding-top: 16px;
        padding-bottom: BadgeTip.progress != "" ? 16px : 24px;
        spacing: 16px;
        HorizontalLayout {
            alignment: center;
            height: 64px;
            Image {
                source: root.level-picture;
                height: 64px;
                width: self.source.height > 0 ? 64px * self.source.width / self.source.height : 0px;
                image-fit: contain;
            }
        }
        VerticalLayout {
            spacing: 4px;
            if BadgeTip.kind != "": Text { text: BadgeTip.kind; color: #c5c6ca; font-size: 14px; font-weight: 500; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: BadgeTip.title.to-uppercase(); color: #ffffff; font-size: 16px; font-weight: 900; horizontal-alignment: center; wrap: word-wrap; }
            if BadgeTip.progress != "": Text { text: BadgeTip.progress; color: #c5c6ca; font-size: 14px; font-weight: 500; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}

// One of someone's activities on their profile, as Discord's card shows it:
// its pictures, its lines, and how long it's run or how far it's got.
export component ActivityCard inherits VerticalLayout {
    in property <ActivityRow> activity;
    callback open-link(string);
    property <bool> timed: root.activity.start > 0 || root.activity.end > 0;
    // A song, with its start and end, shows how far it's got on a bar.
    property <bool> bar: root.activity.start > 0 && root.activity.end > root.activity.start;
    property <int> length: root.activity.end - root.activity.start;
    property <int> played: max(0, min(self.length, ActivityClock.now - root.activity.start));
    /// `0:42`, `12:05` or `1:02:03`.
    pure function clock(seconds: int) -> string {
        let hours = floor(seconds / 3600);
        let minutes = Math.mod(floor(seconds / 60), 60);
        let rest = Math.mod(seconds, 60);
        (hours > 0 ? hours + ":" + (minutes < 10 ? "0" : "") : "") + minutes + ":" + (rest < 10 ? "0" : "") + rest
    }
    spacing: 8px;
    ProfileHeading { text: root.activity.heading; }
    HorizontalLayout {
        spacing: 12px;
        if root.activity.large-url != "": Rectangle {
            width: 64px; height: 64px;
            ActivityPicture { size: 64px; url: root.activity.large-url; label: root.activity.large-text; }
            if root.activity.small-url != "": Rectangle {
                x: 44px; y: 44px; width: 26px; height: 26px; border-radius: 13px; background: Theme.sidebar;
                Rectangle {
                    width: 22px; height: 22px; border-radius: 11px; clip: true;
                    ActivityPicture { size: 22px; border-radius: 11px; url: root.activity.small-url; label: root.activity.small-text; }
                }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            if root.activity.link == "": StatusText { text: root.activity.name; emoji-url: root.activity.name-emoji; color: Theme.text; font-size: 14px; font-weight: 700; }
            // A song's title opens its page, as in Discord.
            if root.activity.link != "": HorizontalLayout {
                alignment: start;
                Text {
                    text: root.activity.name; color: title-pointer.has-hover ? Theme.link : Theme.text;
                    font-size: 14px; font-weight: 700; overflow: elide;
                    accessible-role: button;
                    accessible-label: "Open " + root.activity.name;
                    accessible-action-default => { root.open-link(root.activity.link); }
                    title-pointer := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.open-link(root.activity.link); }
                    }
                }
            }
            if root.activity.details != "": Text { text: root.activity.details; color: Theme.secondary; font-size: 13px; overflow: elide; }
            if root.activity.state != "": Text { text: root.activity.state; color: Theme.secondary; font-size: 13px; overflow: elide; }
            if root.timed && !root.bar: Text {
                text: root.activity.start > 0
                    ? root.clock(max(0, ActivityClock.now - root.activity.start)) + " elapsed"
                    : root.clock(max(0, root.activity.end - ActivityClock.now)) + " left";
                color: Theme.muted; font-size: 12px;
            }
        }
    }
    if root.bar: VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 4px; border-radius: 2px; background: Theme.raised;
            Rectangle {
                x: 0px; width: parent.width * root.played / max(1, root.length);
                border-radius: 2px; background: Theme.text;
            }
        }
        HorizontalLayout {
            Text { text: root.clock(root.played); color: Theme.muted; font-size: 12px; }
            Text { text: root.clock(root.length); color: Theme.muted; font-size: 12px; horizontal-alignment: right; }
        }
    }
    if root.activity.url != "": HorizontalLayout {
        alignment: start;
        ActionButton { text: "Watch stream"; small: true; clicked => { root.open-link(root.activity.url); } }
    }
}

// A server a profile lists as mutual, as a card: what it is, and a way in.
export component ServerCard inherits Rectangle {
    in property <ProfileServerRow> server;
    callback open;
    height: body.preferred-height;
    background: Theme.sidebar;
    border-radius: 12px; border-width: 1px; border-color: Theme.edge;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox;
    accessible-label: root.server.name;
    // Clicks on the card stay on it, instead of closing it.
    TouchArea { }
    Rectangle {
        border-radius: 12px; clip: true;
        body := VerticalLayout {
            padding-bottom: 16px; spacing: 0px;
            // The banner, with the icon hanging over its lower edge.
            Rectangle {
                height: 90px + 32px + 8px;
                Rectangle {
                    y: 0px; height: 90px; background: Theme.raised;
                    if root.server.banner.width > 0: Image {
                        width: parent.width; height: parent.height; source: root.server.banner; image-fit: cover;
                    }
                }
                Rectangle {
                    x: 10px; y: 90px - 32px - 6px; width: 76px; height: 76px; border-radius: 22px;
                    background: Theme.sidebar;
                    Rectangle {
                        width: 64px; height: 64px; border-radius: 18px; clip: true;
                        background: root.server.picture.width > 0 ? transparent : Theme.raised;
                        if root.server.picture.width == 0: Text {
                            text: root.server.initial; color: Theme.text; font-size: 24px; font-weight: 700;
                        }
                        if root.server.picture.width > 0: Image { source: root.server.picture; width: 64px; height: 64px; image-fit: cover; }
                    }
                }
            }
            VerticalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 14px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: root.server.name; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                    HorizontalLayout {
                        spacing: 14px; alignment: start;
                        if root.server.members != "": HorizontalLayout {
                            spacing: 6px;
                            Middle { Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.faint; } }
                            Text { text: root.server.members; color: Theme.secondary; font-size: 13px; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Middle { Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.faint; } }
                            Text { text: root.server.channels; color: Theme.secondary; font-size: 13px; }
                        }
                    }
                }
                if root.server.nick != "": VerticalLayout {
                    spacing: 4px;
                    ProfileHeading { text: "THEIR NICKNAME"; }
                    Text { text: root.server.nick; color: Theme.text; font-size: 14px; overflow: elide; }
                }
                ActionButton { text: "Go to server"; primary: true; clicked => { root.open(); } }
            }
        }
    }
}

// A mutual server or friend in a profile. Clicking it goes there.
export component ProfileListRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> initial;
    in property <color> tint: Theme.raised;
    in property <image> picture;
    /// A person, drawn round with their status dot; else a server, drawn as
    /// a rounded square.
    in property <bool> person;
    in property <string> presence;
    in property <string> label;
    callback clicked;
    height: root.detail != "" ? 46px : 40px; border-radius: 6px;
    background: pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 12px;
        Middle {
            Rectangle {
                width: 32px; height: 32px;
                if root.person: Avatar { size: 32px; initial: root.initial; tint: root.tint; picture: root.picture; }
                if root.person && root.presence != "": StatusDot {
                    x: 20px; y: 20px; presence: root.presence; ring: pointer.has-hover ? Theme.hover : Theme.sidebar;
                }
                if !root.person: Rectangle {
                    border-radius: 10px; clip: true;
                    background: root.picture.width > 0 ? transparent : Theme.raised;
                    if root.picture.width == 0: Text {
                        text: root.initial; color: Theme.text; font-size: 13px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.picture.width > 0: Image { source: root.picture; width: 32px; height: 32px; image-fit: cover; }
                }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 0px; horizontal-stretch: 1;
            Text { text: root.name; color: Theme.text; font-size: 15px; font-weight: 500; overflow: elide; }
            if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
}

// A person's profile: a card beside the member list, large over the
// window, where it scrolls once it's taller than the window allows, or
// docked beside a one-to-one DM, where it fills the height.
export component ProfileCard inherits Rectangle {
    in property <ProfileData> data;
    in property <bool> large;
    in property <bool> docked;
    /// A preview of one's own, as the server profile editor shows it, which
    /// opens nothing.
    in property <bool> preview;
    /// It shows everything: the bio in full, and mutual servers and friends.
    property <bool> full: root.large || root.docked;
    /// The tallest the card may be.
    in property <length> limit: 100000px;
    callback enlarge;
    callback close;
    callback open-link(string);
    callback befriend;
    /// The card's "..." was clicked, at this place in the window: it opens
    /// the person's menu.
    callback more(length, length);
    /// A mutual server or friend was clicked, with where its row is in the window.
    callback open-server(ProfileServerRow, length, length, length, length);
    callback open-friend(string, length, length, length, length);
    /// Enter in the card's message box, with what it held.
    callback send-message(string);
    property <length> banner-height: root.large ? 210px : root.docked ? (ClientStyle.enabled ? 105px : 120px) : 105px;
    property <length> avatar-size: root.large ? 120px : 80px;
    property <length> pad: root.large ? 24px : 16px;
    // A profile theme, as Discord draws it: the card's gradient runs from
    // the first colour to the second under a 60% black wash, flat down to the
    // banner's end, inside a 1px border that is the same two colours,
    // washed out into the card's own ground.
    property <bool> themed: root.data.has-theme;
    property <color> plain-ground: root.docked && ClientStyle.enabled ? Theme.panel : Theme.sidebar;
    property <color> theme-start: root.data.theme-primary.mix(#000000, 0.4);
    property <color> theme-end: root.data.theme-secondary.mix(#000000, 0.4);
    /// What lies behind the avatar's ring, where the banner ends.
    property <color> ground: root.themed ? root.theme-start : root.plain-ground;
    height: min(body.preferred-height, root.limit);
    background: root.themed ? @linear-gradient(180deg, root.data.theme-primary.mix(root.plain-ground, 0.2) 0%, root.data.theme-secondary.mix(root.plain-ground, 0.6) 100%) : root.plain-ground;
    border-radius: root.docked ? (ClientStyle.enabled ? 8px : 0px) : 12px; border-width: root.docked || root.themed ? 0px : 1px; border-color: Theme.edge;
    drop-shadow-blur: root.docked ? 0px : 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: root.docked ? 0px : 8px;
    accessible-role: groupbox;
    accessible-label: root.data.name + "'s profile";
    // Clicks on the card stay on it, instead of closing it.
    TouchArea { }
    Rectangle {
        x: root.themed ? 1px : 0px; y: root.themed ? 1px : 0px;
        width: parent.width - (root.themed ? 2px : 0px); height: parent.height - (root.themed ? 2px : 0px);
        border-radius: (root.docked ? (ClientStyle.enabled ? 8px : 0px) : 12px) - (root.themed ? 1px : 0px); clip: true;
        if root.themed: Rectangle {
            background: @linear-gradient(180deg, root.theme-start 0%, root.theme-start root.banner-height / parent.height * 100%, root.theme-end 100%);
        }
        // Sized by what the card wants rather than the least it can take, so a
        // long one scrolls to its end.
        ScrollView {
            y: 0px; height: parent.height - (root.docked && ClientStyle.enabled ? 52px : 0px);
            content-height: body.preferred-height;
            body := VerticalLayout {
                padding-bottom: root.pad; spacing: 0px;
                // The banner, with the avatar hanging over its lower edge.
                Rectangle {
                    height: root.banner-height + root.avatar-size / 2 + 8px;
                    Rectangle {
                        y: 0px; height: root.banner-height;
                        background: root.data.has-accent ? root.data.accent : root.themed ? root.data.theme-primary : Theme.raised;
                        if root.data.banner.width > 0: Image {
                            width: parent.width; height: parent.height; source: root.data.banner; image-fit: cover;
                        }
                    }
                    Rectangle {
                        x: root.pad - 6px; y: root.banner-height - root.avatar-size / 2 - 6px;
                        width: root.avatar-size + 12px; height: self.width; border-radius: self.width / 2;
                        background: root.ground;
                        Avatar { size: root.avatar-size; initial: root.data.initial; tint: root.data.tint; picture: root.data.picture; decoration-url: root.data.decoration-url; animate: true; }
                        if root.data.presence != "" && root.data.presence != "offline": StatusDot {
                            x: parent.width - self.width - (root.large ? 14px : 10px); y: parent.height - self.height - (root.large ? 14px : 10px);
                            presence: root.data.presence; ring: root.ground;
                        }
                        // The picture opens the full profile.
                        if !root.large && !root.preview: TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            accessible-role: button;
                            accessible-label: "View full profile";
                            accessible-action-default => { root.enlarge(); }
                            clicked => { root.enlarge(); }
                        }
                    }
                }
                VerticalLayout {
                    padding-left: root.pad; padding-right: root.pad; spacing: 16px;
                    VerticalLayout {
                        spacing: 2px;
                        if root.data.name-style.effect == 0: Text {
                            text: root.data.name; color: Theme.text; font-size: root.large ? 26px : 20px; font-weight: 700;
                            overflow: elide;
                            if !root.large && !root.preview: TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.enlarge(); } }
                        }
                        if root.data.name-style.effect > 0: StyledName {
                            text: root.data.name; style: root.data.name-style; ink: Theme.text; font-size: root.large ? 26px : 20px; font-weight: 700;
                            if !root.large && !root.preview: TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.enlarge(); } }
                        }
                        if root.data.handle != "" || root.data.tag != "": HorizontalLayout {
                            spacing: 6px; alignment: start;
                            if root.data.handle != "": Text { text: root.data.handle; color: Theme.secondary; font-size: 14px; font-weight: 500; overflow: elide; vertical-alignment: center; }
                            if root.data.tag != "": Middle { ServerTagChip { text: root.data.tag; badge: root.data.tag-badge; font-weight: 400; chip-height: 24px; pad: 8px; radius: 8px; fill: #97979f1f; outline: #97979f0a; outline-width: 1px; } }
                        }
                        if root.data.activity != "" || root.data.activity-emoji != "": StatusText {
                            text: root.data.activity; emoji-url: root.data.activity-emoji;
                            color: Theme.secondary; font-size: 14px; wrap: word-wrap; max-height: 40px;
                        }
                    }
                    // Discord sets the badges in a pill of their own: 20px icons 2px
                    // apart, 3px by 1px inside a 1px border, 8px corners, a grey wash
                    // that brightens when the pointer is over it.
                    if root.data.badges.length > 0: HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: root.data.badges.length * 22px + 6px; height: 24px;
                            background: pill-hover.has-hover ? #97979f33 : #97979f1f;
                            border-radius: 8px; border-width: 1px; border-color: #97979f0a;
                            pill-hover := TouchArea { mouse-cursor: MouseCursor.default; }
                            HorizontalLayout {
                                padding-left: 3px; padding-right: 3px; padding-top: 1px; padding-bottom: 1px; spacing: 2px;
                                for badge in root.data.badges: ProfileBadge {
                                    badge: badge;
                                    open-link(url) => { root.open-link(url); }
                                }
                            }
                        }
                    }
                    for activity in root.data.activities: ActivityCard {
                        activity: activity;
                        open-link(url) => { root.open-link(url); }
                    }
                    // The card names what is shared, with a few of the faces; the
                    // full profile lists it.
                    if !root.full && (root.data.friends.length > 0 || root.data.servers.length > 0): Rectangle {
                        height: 24px;
                        accessible-role: button;
                        accessible-label: "Show mutual friends and servers in the full profile";
                        accessible-action-default => { root.enlarge(); }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            if root.data.friends.length > 0: HorizontalLayout {
                                spacing: 6px;
                                Middle {
                                    Rectangle {
                                        width: min(3, root.data.friends.length) * 12px + 6px; height: 18px;
                                        for friend[index] in root.data.friends: Rectangle {
                                            x: index * 12px; width: 18px; height: 18px; visible: index < 3;
                                            Rectangle { width: 18px; height: 18px; border-radius: 9px; background: root.ground; }
                                            Avatar { x: 1px; y: 1px; size: 16px; initial: friend.initial; tint: friend.tint; picture: friend.picture; }
                                        }
                                    }
                                }
                                Text { text: root.data.friends.length + (root.data.friends.length == 1 ? " mutual friend" : " mutual friends"); color: Theme.secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                            }
                            if root.data.friends.length > 0 && root.data.servers.length > 0: Text { text: "\u{b7}"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                            if root.data.servers.length > 0: HorizontalLayout {
                                spacing: 6px;
                                Middle {
                                    Rectangle {
                                        width: min(3, root.data.servers.length) * 12px + 6px; height: 18px;
                                        for server[index] in root.data.servers: Rectangle {
                                            x: index * 12px; width: 18px; height: 18px; visible: index < 3;
                                            Rectangle { width: 18px; height: 18px; border-radius: 9px; background: root.ground; }
                                            Avatar { x: 1px; y: 1px; size: 16px; initial: server.initial; picture: server.picture; }
                                        }
                                    }
                                }
                                Text { text: root.data.servers.length + (root.data.servers.length == 1 ? " mutual server" : " mutual servers"); color: Theme.secondary; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                            }
                        }
                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.enlarge(); } }
                    }
                    if root.data.has-bio: VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "ABOUT ME"; }
                        // The card shows the start; the full profile shows it all.
                        // A fixed height, since the text would otherwise stretch it past its limit.
                        Rectangle {
                            clip: true;
                            height: root.full ? bio-text.preferred-height : min(110px, bio-text.preferred-height);
                            VerticalLayout {
                                bio-text := StyledText {
                                    text: root.data.bio; default-color: Theme.text; link-color: Theme.link;
                                    link-clicked(link) => { root.open-link(link); }
                                }
                            }
                        }
                        // Only where the card cut the text short; its height, not
                        // its presence, follows that, so the layout's width does not.
                        Text {
                            property <bool> cut: !root.full && !root.preview && bio-text.preferred-height > 110px;
                            height: self.cut ? 20px : 0px; visible: self.cut;
                            text: "View full bio"; color: Theme.link; font-size: 14px; font-weight: 500;
                            TouchArea { enabled: parent.cut; mouse-cursor: MouseCursor.pointer; clicked => { root.enlarge(); } }
                        }
                    }
                    // The card leaves the dates to the full profile.
                    if root.full && (root.data.created != "" || root.data.joined != ""): VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "MEMBER SINCE"; }
                        HorizontalLayout {
                            spacing: 24px; alignment: start;
                            if root.data.created != "": VerticalLayout {
                                Text { text: root.data.created; color: Theme.text; font-size: 14px; font-weight: 500; }
                                Text { text: "On Discord"; color: Theme.muted; font-size: 12px; }
                            }
                            if root.data.joined != "": VerticalLayout {
                                Text { text: root.data.joined; color: Theme.text; font-size: 14px; font-weight: 500; }
                                Text { text: "In this server"; color: Theme.muted; font-size: 12px; }
                            }
                        }
                    }
                    if (root.large ? root.data.role-rows-large : root.data.role-rows).length > 0: VerticalLayout {
                        spacing: 6px;
                        // The card's chips speak for themselves.
                        if root.full: ProfileHeading { text: "ROLES"; }
                        for row in (root.large ? root.data.role-rows-large : root.data.role-rows): HorizontalLayout {
                            spacing: 4px; alignment: start;
                            for role in row.roles: Rectangle {
                                height: 24px; border-radius: 4px; background: Theme.raised;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                                    Middle { Rectangle { width: 10px; height: 10px; border-radius: 5px; background: role.has-color ? role.color : Theme.faint; } }
                                    Text { text: role.name; color: Theme.secondary; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if root.full && root.data.servers.length > 0: VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "MUTUAL SERVERS — " + root.data.servers.length; }
                        VerticalLayout {
                            spacing: 0px;
                            for server in root.data.servers: ProfileListRow {
                                name: server.name; initial: server.initial; picture: server.picture;
                                detail: server.nick;
                                label: "Open " + server.name + (server.nick != "" ? ", where they're " + server.nick : "");
                                clicked => { root.open-server(server, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            }
                        }
                    }
                    if root.full && root.data.friends.length > 0: VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "MUTUAL FRIENDS — " + root.data.friends.length; }
                        VerticalLayout {
                            spacing: 0px;
                            for friend in root.data.friends: ProfileListRow {
                                person: true; name: friend.name; initial: friend.initial; tint: friend.tint;
                                picture: friend.picture; presence: friend.presence;
                                label: friend.name + "'s profile";
                                clicked => { root.open-friend(friend.id, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            }
                        }
                    }
                    if root.data.note != "": Text { text: root.data.note; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    // Escape in the box closes the card, as it does elsewhere.
                    if !root.large && !root.preview && root.data.message-hint != "": FocusScope {
                        // It empties for someone else's profile.
                        property <string> person: root.data.id;
                        changed person => { message-field.text = ""; }
                        key-pressed(event) => {
                            if event.text == Key.Escape { root.close(); return accept; }
                            return reject;
                        }
                        message-field := TextField {
                            placeholder: root.data.message-hint; label: root.data.message-hint;
                            text-size: 14px; border-radius: 8px; fill: root.themed ? #0000004d : Theme.sunken;
                            accepted => {
                                if self.text != "" {
                                    root.send-message(self.text);
                                    self.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }
        // The friend request and the person's menu sit over the banner's
        // top right corner, as in Discord.
        if !root.preview && (root.data.friend > 0 || root.data.id != ""): HorizontalLayout {
            x: parent.width - self.preferred-width - (root.large ? 54px : 10px); y: 10px;
            height: 32px; spacing: 8px;
            if root.data.friend > 0: Rectangle {
                width: 32px; height: 32px; border-radius: 16px;
                background: friend-touch.has-hover && root.data.friend != 2 ? #000000b3 : #00000080;
                accessible-role: button;
                accessible-enabled: root.data.friend != 2;
                accessible-label: root.data.friend == 1 ? "Send friend request" : root.data.friend == 2 ? "Friend request sent" : "Accept friend request";
                accessible-action-default => { root.befriend(); }
                Image { source: @image-url("icons/user-plus.svg"); width: 18px; height: 18px; x: 7px; y: 7px; colorize: #ffffff; opacity: root.data.friend == 2 ? 0.5 : 1; }
                friend-touch := TouchArea {
                    enabled: root.data.friend != 2; mouse-cursor: MouseCursor.pointer;
                    clicked => { root.befriend(); }
                }
            }
            if root.data.id != "": Rectangle {
                width: 32px; height: 32px; border-radius: 16px;
                background: more-touch.has-hover ? #000000b3 : #00000080;
                accessible-role: button;
                accessible-label: "More actions";
                accessible-action-default => { root.more(self.absolute-position.x, self.absolute-position.y + self.height); }
                Image { source: @image-url("icons/ellipsis.svg"); width: 18px; height: 18px; x: 7px; y: 7px; colorize: #ffffff; }
                more-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.more(self.absolute-position.x, self.absolute-position.y + self.height); }
                }
            }
        }
        // The profile effect plays over the card, in front of what it holds;
        // clicks go through it.
        if root.data.effect-layers.length > 0: ProfileEffect {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            layers: root.data.effect-layers; still-url: root.data.effect-still; persistent: root.data.effect-persistent;
            end: root.data.effect-end; loops: root.data.effect-loops;
        }
    }
    if root.large: Rectangle {
        x: parent.width - 44px; y: 10px; width: 34px; height: 34px; border-radius: 17px; background: #00000080;
        IconButton { icon: @image-url("icons/x.svg"); label: "Close profile"; tint: #ffffff; clicked => { root.close(); } }
    }
    if root.docked && ClientStyle.enabled: Rectangle {
        x: 16px; y: parent.height - 48px; width: parent.width - 32px; height: 36px;
        ActionButton { width: parent.width; text: "View Full Profile"; clicked => { root.enlarge(); } }
    }
}

// A role mentioned in a message, as a card: who Yapfast knows has it.
export component RoleCard inherits Rectangle {
    in property <string> role-name;
    in property <color> role-color;
    in property <bool> role-has-color;
    in property <[MemberRow]> role-members;
    in property <string> role-note;
    /// The tallest the card may be.
    in property <length> limit;
    /// Someone was clicked: their id, and where the card and their row are in the window.
    callback open-member(string, length, length, length, length);
    /// Someone was chosen without the pointer.
    callback choose-member(string);
    width: 260px; height: min(root.limit, role-content.preferred-height);
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox;
    accessible-label: "Role " + root.role-name;
    TouchArea { }
    role-content := VerticalLayout {
        padding: 12px; spacing: 4px;
        HorizontalLayout {
            spacing: 8px; padding-bottom: 4px;
            Middle { Rectangle { width: 12px; height: 12px; border-radius: 6px; background: root.role-has-color ? root.role-color : Theme.muted; } }
            Text { text: "@" + root.role-name; color: root.role-has-color ? root.role-color : Theme.text; font-size: 16px; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        }
        if root.role-note != "": Label { text: root.role-note; }
        ScrollView {
            max-height: 320px;
            VerticalLayout {
                spacing: 0px; alignment: start;
                for member in root.role-members: Rectangle {
                    height: 40px; border-radius: 6px;
                    background: member-touch.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: member.name;
                    accessible-action-default => { root.choose-member(member.id); }
                    HorizontalLayout {
                        padding-left: 6px; padding-right: 6px; spacing: 10px;
                        Middle { Avatar { size: 28px; initial: member.initial; tint: member.tint; picture: member.picture; picture-url: member.picture-url; } }
                        Text { text: member.name; color: member.has-color ? member.color : Theme.text; font-size: 15px; font-weight: 500; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    member-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.open-member(member.id, root.x, self.absolute-position.y, root.width, self.height); }
                    }
                }
            }
        }
    }
}
